    <Method Name="FB_exit" Id="{b010e223-03dd-4125-a4b4-ddc07a5a79e9}" FolderPath="Implicit\">
      <Declaration><![CDATA[METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
END_VAR
VAR
	ipThis	: I_Alarm;
	ipPrev	: I_Alarm;
	nGuard	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.fbTcAlarm.ipArguments.Clear();
	THIS^.fbTcAlarm.Release();
	
	ipThis := THIS^;
	IF GVL_Diag.ipAlarmHead = ipThis THEN
		GVL_Diag.ipAlarmHead := _ipNext;
		IF GVL_Diag.gnCountAlarms > 0 THEN
			GVL_Diag.gnCountAlarms := GVL_Diag.gnCountAlarms - 1;
		END_IF
	ELSE
		ipPrev := GVL_Diag.ipAlarmHead;
		nGuard := 0;
		WHILE ipPrev <> 0 AND nGuard < Parameter.nMaxNumberAlarms DO
			nGuard := nGuard + 1;
			IF ipPrev.ipNext = ipThis THEN
				ipPrev.ipNext := _ipNext;
				IF GVL_Diag.gnCountAlarms > 0 THEN
					GVL_Diag.gnCountAlarms := GVL_Diag.gnCountAlarms - 1;
				END_IF
				EXIT;
			END_IF
			ipPrev := ipPrev.ipNext;
		END_WHILE
	END_IF
	_ipNext := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{627e0ae0-1633-4d21-88ee-b0f72da5a7db}" FolderPath="Implicit\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
	
	stTmpEventClass	: TcEventEntry;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// no online-change
IF NOT bInCopyCode THEN
	
	// detect config error, if too many events were created during initializing
	IF GVL_Diag.gnCountAlarms >= Parameter.nMaxNumberAlarms THEN
		GVL_Diag.gbCountAlarmsMaxExceeded := TRUE;
	ELSE
		_stEventClass := stTmpEventClass;
		// standard event reaction depending of the event class severity
		CASE _stEventClass.eSeverity OF
			TcEventSeverity.Critical:
				_eEventReaction := E_AlarmReaction.MediaOff;
			TcEventSeverity.Error:
				_eEventReaction := E_AlarmReaction.AbortAll;
			TcEventSeverity.Warning:
				_eEventReaction := E_AlarmReaction.Warning;
			TcEventSeverity.Info:
				_eEventReaction := E_AlarmReaction.Info;
			TcEventSeverity.Verbose:
				_eEventReaction := E_AlarmReaction.Verbose;
		END_CASE
		
		{warning 'TODO: Understanding of Confirmation System'}
		// _bWithConfirmation := SEL( _stEventClass.eSeverity = TcEventSeverity.Error OR _stEventClass.eSeverity = TcEventSeverity.Critical, FALSE, TRUE);
		_bWithConfirmation := FALSE;
		
		THIS^.fbTcAlarm.CreateEx(
			_stEventClass,
			_bWithConfirmation,
			THIS^._fbInternalSourceInfo );
		
		Register();
		
	END_IF
	
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Register" Id="{294e071a-c385-45d7-e0bd-816254a3d57c}" FolderPath="Implicit\">
      <Declaration><![CDATA[METHOD PRIVATE Register : BOOL
VAR
	ipAlarm	: I_Alarm;
	ipThis	: I_Alarm;
	nGuard	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
ipThis := THIS^;

ipAlarm := GVL_Diag.ipAlarmHead;
nGuard := 0;
WHILE ipAlarm <> 0 AND nGuard < Parameter.nMaxNumberAlarms DO
	IF ipAlarm = ipThis THEN
		RETURN;
	END_IF
	ipAlarm := ipAlarm.ipNext;
	nGuard := nGuard + 1;
END_WHILE

IF GVL_Diag.gnCountAlarms >= Parameter.nMaxNumberAlarms THEN
	GVL_Diag.gbCountAlarmsMaxExceeded := TRUE;
	RETURN;
END_IF

_ipNext := GVL_Diag.ipAlarmHead;
GVL_Diag.ipAlarmHead := ipThis;
GVL_Diag.gnCountAlarms := GVL_Diag.gnCountAlarms + 1;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetEventEntry" Id="{86d82901-5718-4b2a-a118-c465ead0d321}">
      <Declaration><![CDATA[METHOD GetEventEntry : ST_EventEntryTable
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
GetEventEntry.sText := THIS^.sText;
GetEventEntry.sSourceName := THIS^.fbTcAlarm.ipSourceInfo.sName;
GetEventEntry.nSourceId := THIS^.fbTcAlarm.ipSourceInfo.nId;
GetEventEntry.nGroupId := THIS^.nGroupId;

GetEventEntry.sTimestamp := THIS^.sTimeRaised;

GetEventEntry.eSeverity := THIS^.fbTcAlarm.eSeverity;
CASE THIS^.fbTcAlarm.eSeverity OF
	TcEventSeverity.Verbose:	GetEventEntry.sSeverity := 'Verbose';
	TcEventSeverity.Info:		GetEventEntry.sSeverity := 'Info';
	TcEventSeverity.Warning:	GetEventEntry.sSeverity := 'Warning';
	TcEventSeverity.Error:		GetEventEntry.sSeverity := 'Error';
	TcEventSeverity.Critical:	GetEventEntry.sSeverity := 'Critical';
	ELSE	GetEventEntry.sSeverity := 'None';
END_CASE

CASE _eEventReaction OF
	E_AlarmReaction.AbortAll:	GetEventEntry.sReaction := 'Abort All';
	E_AlarmReaction.AbortGroup:	GetEventEntry.sReaction := 'Abort Group';
	E_AlarmReaction.Info:		GetEventEntry.sReaction := 'Info';
	E_AlarmReaction.MediaOff:	GetEventEntry.sReaction := 'Media Off';
	E_AlarmReaction.None:		GetEventEntry.sReaction := 'None';
	E_AlarmReaction.StopAtCycleEnd:	GetEventEntry.sReaction := 'StopAtCycleEnd';
	E_AlarmReaction.Verbose:	GetEventEntry.sReaction := 'Verbose';
	E_AlarmReaction.Warning:	GetEventEntry.sReaction := 'Warning';
	ELSE	GetEventEntry.sReaction := 'None';
END_CASE

GetEventEntry.EventClass := THIS^.fbTcAlarm.EventClass;
GetEventEntry.EventClassName := THIS^.sClassName;

GetEventEntry.nEventId := THIS^.fbTcAlarm.nEventId;
// GetEventEntry.ipArguments := fbTcAlarm.ipArguments;
GetEventEntry.eConfirmationState := THIS^.fbTcAlarm.eConfirmationState;
GetEventEntry.bIsAlarm := TRUE;
GetEventEntry.bIsEvent := FALSE;

GetEventEntry.nLanguageId := THIS^.nLangId;

(*
	sJsonAttribute: STRING(8000);
#	sText: STRING(255); // 
#	sSourceName: STRING(255); // 
#	nSourceId: UDINT; // 
	sDescription: STRING(255);
#	eSeverity: TcEventSeverity; // INT
#	sSeverity: STRING;
#	EventClass: GUID;
#	EventClassName: STRING(255); //
	sTimestampLog : STRING;
	sTimestamp: STRING; // 
	sTimestampConfirmed: STRING;
	sTimestampCleared: STRING;
#	nEventId: UDINT;
#	ipArguments: I_TcArguments;
#	eConfirmationState: TcEventConfirmationState; // 
	bTextReceived: BOOL;
#	bIsAlarm: BOOL;
#	bIsEvent: BOOL;
	stAlarmLog : ST_AlarmLog;
	bLogged : BOOL;
#	nLanguageId : INT;
*)
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetEventText" Id="{d5de04b7-7955-4bec-9baf-128389b6ad92}">
      <Declaration><![CDATA[METHOD GetEventText : BOOL
VAR_INPUT
END_VAR
VAR_INST
	bReqTextError	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
GetEventText := FALSE;

IF THIS^.fbTcAlarm.RequestEventText(
	nLangId		:= 1031,
	sResult		:= sText,
	nResultSize	:= SIZEOF( sText ),
	bError		=> bReqTextError
) THEN
	GetEventText := TRUE;
END_IF

IF bReqTextError THEN
	sText := '';
END_IF
]]></ST>
      </Implementation>
    </Method>
