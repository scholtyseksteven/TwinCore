    <Method Name="Clear" Id="{b4598298-7436-4f69-a19e-439a37d7111c}" FolderPath="Standard\">
      <Declaration><![CDATA[METHOD Clear : HRESULT
VAR_INPUT
	nTimeStamp			: ULINT;
	bResetConfirmation	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
