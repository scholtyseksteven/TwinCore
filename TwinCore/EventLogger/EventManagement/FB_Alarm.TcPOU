<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Alarm" Id="{9ad75833-ec6e-4f0e-b6e0-1de1dd98cb7a}" SpecialFunc="None">
    <Declaration><![CDATA[//Usage description
//-----------------
//| This FB uses the FB_init, which needs to be initialized within the declaration!
//| Also it can use the method Initialization, to specify Group/Zone IDs of the Event. Here you can also change the alarm reaction
//| FB_init / Initialize prepend this instance onto GVL_Diag.ipAlarmHead (linked list, no GVL table).
//| use SetEvent[...] -methods to raise an alarm!
//| 
//| You can trigger an alarm once or use it cyclically.
//| The :ref:`FB_AlarmManagement` prevent acknowledge automatically if SetAlarm is still set.
FUNCTION_BLOCK FB_Alarm IMPLEMENTS I_Alarm
VAR_INPUT
END_VAR
VAR_OUTPUT
	sText		: STRING := '';
	sClassName	: STRING := '';
	sTimeRaised	: STRING := '';
	nGroupId	: UINT;
	nZoneId		: UINT;
END_VAR
VAR
	_bSetEvent				: BOOL;
	_bBlockAck				: BOOL;
	_bWithConfirmation		: BOOL;
	fbTcAlarm				: FB_TcAlarm;
	_fbInternalSourceInfo	: Tc3_EventLogger.FB_TcSourceInfo;	// needed to have "multi-instances" of EventClass in CreateEx()
	nLangId					: INT;
	
    fbRequestText : FB_RequestEventText;
    fbRequestClassName : FB_RequestEventClassName;
	
	_stEventClass	: TcEventEntry;
	_eEventReaction	: E_AlarmReaction;
	_ipNext			: I_Alarm;
	_nArgumentCount: UDINT;
	
	hrRaise	: HRESULT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Implicit" Id="{4843c30d-fd2f-4320-b66e-dc0779dc33de}" />
    <Folder Name="Properties" Id="{4d9a9e82-60b1-4eed-a3e7-6dcb1f955fae}" />
    <Folder Name="Standard" Id="{97593be8-8252-420b-8b64-6f7510127df7}" />
    <Method Name="Ack" Id="{3bb8880a-1258-4d53-a05a-4ee5e82110b2}" FolderPath="Standard\">
      <Declaration><![CDATA[METHOD Ack : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF NOT _bBlockAck AND_THEN THIS^.bActive THEN
	Ack := THIS^.fbTcAlarm.Clear( 0, FALSE );
ELSE
	Ack := 1;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddArgument" Id="{00329942-543f-413c-8c60-b737a3dcc752}">
      <Declaration><![CDATA[METHOD PUBLIC AddArgument : REFERENCE TO FB_Alarm
VAR_INPUT
	sName	: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
THIS^.fbTcAlarm.ipArguments.AddString( sName );
addArgument REF= THIS^;
_nArgumentCount := _nArgumentCount + 1;
]]></ST>
      </Implementation>
    </Method>
