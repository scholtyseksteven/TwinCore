    <Method Name="Raise" Id="{6470e96b-a3db-46e2-8780-266856f82011}" FolderPath="Standard\">
      <Declaration><![CDATA[METHOD Raise : HRESULT
VAR_INPUT
	nTimeStamp	: ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.fbTcAlarm.Raise( 0 );

THIS^.sTimeRaised := SYSTEMTIME_TO_STRING(
	UlintToSystemTime(
		THIS^.fbTcAlarm.nTimeRaised,
		GVL_Diag.gfbAlarmManagement.fbGetTimeZoneInformation.tzInfo ) );
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEvent" Id="{7b73aac3-bfee-4830-89bc-1f3cab7b52b5}">
      <Declaration><![CDATA[METHOD PUBLIC SetEvent : REFERENCE TO FB_Alarm
VAR_INPUT
	bSetEvent	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF bSetEvent
AND_THEN NOT THIS^._bSetEvent
AND_THEN NOT THIS^.bActive THEN
	hrRaise := THIS^.Raise( 0 );
	GVL_Diag.gfbLogFile.addEntry( THIS^ );
END_IF
_bSetEvent := bSetEvent;
_bBlockAck S= bSetEvent;

setEvent REF= THIS^;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEventWithOneArgument" Id="{dc7cd21d-e80f-44dd-aac7-a425847ab236}">
      <Declaration><![CDATA[METHOD PUBLIC SetEventWithOneArgument : REFERENCE TO FB_Alarm
VAR_INPUT
	bSetEvent		: BOOL;
	sInName			: STRING;
END_VAR
VAR_INST
	rtSetEvent		: R_TRIG;
END_VAR
VAR
    hr		: HRESULT;
    UTF8	: STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF bSetEvent
AND_THEN NOT THIS^._bSetEvent
AND_THEN NOT THIS^.bActive THEN
	THIS^.start().addArgument( sInName );
	hrRaise := THIS^.Raise( 0 );
	GVL_Diag.gfbLogFile.addEntry( THIS^ );
END_IF
_bSetEvent := bSetEvent;
_bBlockAck S= _bSetEvent;

setEventWithOneArgument REF= THIS^;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="sSeverity" Id="{d166d5e9-91a1-41b1-875f-14acbe7ffbf3}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY PRIVATE sSeverity : STRING]]></Declaration>
      <Get Name="Get" Id="{cb2eb32b-fbba-4c63-992d-00d6485af167}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[
CASE fbTcAlarm.eSeverity OF
	
	TcEventSeverity.Critical:
		sSeverity := 'Critical';
		
	TcEventSeverity.Error:
		sSeverity := 'Error';
		
	TcEventSeverity.Info:
		sSeverity := 'Info';
		
	TcEventSeverity.Verbose:
		sSeverity := 'Verbose';
		
	TcEventSeverity.Warning:
		sSeverity := 'Warning';
		
	ELSE
		sSeverity := 'None';
		
END_CASE]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Start" Id="{264f7d19-2693-416a-8849-25de27f2ef54}">
      <Declaration><![CDATA[METHOD PUBLIC Start : REFERENCE TO FB_Alarm
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
THIS^.fbTcAlarm.ipArguments.Clear();
start REF= THIS^;
_nArgumentCount := 0;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="UlintToSystemTime" Id="{06bd5ce3-e913-489a-afdd-d3fe66927e82}">
      <Declaration><![CDATA[METHOD PRIVATE UlintToSystemTime : TIMESTRUCT
VAR_INPUT
	_fileTime: ULINT;
	_tzInfo: ST_TimeZoneInformation;
END_VAR
VAR
	tfileTime: T_FILETIME;
	tfileTimeZone: T_FILETIME;
	fbFileTimeToTzSpecificLocalTime: FB_FileTimeToTzSpecificLocalTime;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
MEMCPY( ADR( tfileTime ),ADR( _fileTime ), SIZEOF( T_FILETIME ) );
fbFileTimeToTzSpecificLocalTime(
	in := tfileTime, 
	tzInfo := _tzInfo, 
	out => tfileTimeZone, 
	eTzID => , 
	bB => );
UlintToSystemTime := FILETIME_TO_SYSTEMTIME( fileTime:= tfileTimeZone );
]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateText" Id="{00bc1e94-27b1-406f-914e-3c6c82e8d5ed}">
      <Declaration><![CDATA[METHOD PUBLIC UpdateText : HRESULT
VAR_INPUT
	LangId	: INT;
END_VAR
VAR_INST
    nStep : E_AlarmMessage;
    nStepRequestText : E_AlarmMessage := E_AlarmMessage.Done;
    nStepRequestClass : E_AlarmMessage := E_AlarmMessage.Done;
END_VAR
VAR
	
    hr : HRESULT;
    UTF8 : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF ( nStepRequestText <> E_AlarmMessage.Done
	OR nStepRequestClass <> E_AlarmMessage.Done )
AND THIS^.bRaised THEN
	
	// CASE: RequestText   
	IF nStepRequestText = E_AlarmMessage.RequestText THEN
		THIS^.fbRequestText.Request( eventClass := THIS^.fbTcAlarm.EventClass, nEventId := THIS^.fbTcAlarm.nEventId, nLangId := LangId, ipArgs := THIS^.fbTcAlarm.ipArguments );
		nStepRequestText := E_AlarmMessage.ReceiveText;
	END_IF
	
	// CASE: ReceiveText   
	IF nStepRequestText = E_AlarmMessage.ReceiveText THEN
		IF NOT THIS^.fbRequestText.bBusy AND NOT THIS^.fbRequestText.bError THEN
			THIS^.fbRequestText.GetString( UTF8, SIZEOF( UTF8 ) );
			UTF8_TO_STRING(pDstSTRING := ADR( sText ), pSrcUTF8 := ADR( UTF8 ), nDstSize := SIZEOF( sText ), nDstLen => );
			nStepRequestText := E_AlarmMessage.Done;
		ELSIF THIS^.fbRequestText.bError THEN 
			nStepRequestText := E_AlarmMessage.RequestText;
		END_IF
	END_IF
	
    // CASE: RequestClassText   
    IF nStepRequestClass = E_AlarmMessage.RequestText THEN
		THIS^.fbRequestClassName.Request( eventClass := THIS^.fbTcAlarm.EventClass, nLangId := LangId );
		nStepRequestClass := E_AlarmMessage.ReceiveText;
	END_IF
	
    // CASE: ReceiveClassText   
    IF nStepRequestClass = E_AlarmMessage.ReceiveText THEN
        IF NOT THIS^.fbRequestClassName.bBusy AND NOT THIS^.fbRequestClassName.bError THEN
            THIS^.fbRequestClassName.GetString( UTF8, SIZEOF( UTF8 ) );
            UTF8_TO_STRING(pDstSTRING:=ADR( sClassName ), pSrcUTF8 := ADR( UTF8 ), nDstSize:=SIZEOF( sClassName ), nDstLen=> );
            nStepRequestClass := E_AlarmMessage.Done;
        ELSIF THIS^.fbRequestClassName.bError THEN 
            nStepRequestClass := E_AlarmMessage.RequestText;
        END_IF
	END_IF

ELSE
	// reset Text
	IF NOT bRaised OR nLangId <> LangId THEN
		sText := '';
		sClassName := '';
		nStepRequestClass := E_AlarmMessage.RequestText;
		nStepRequestText := E_AlarmMessage.RequestText;
		nLangId := LangId;
	END_IF
END_IF

IF THIS^.fbRequestClassName.bError
OR THIS^.fbRequestText.bError THEN
	UpdateText := E_FAIL;
ELSIF THIS^.fbRequestClassName.bBusy
OR THIS^.fbRequestText.bBusy THEN
	UpdateText := S_OK;
ELSE
	UpdateText := S_PENDING;
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>