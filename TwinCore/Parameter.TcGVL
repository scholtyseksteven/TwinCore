<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="Parameter" Id="{c6b470c0-640d-46d1-99a6-d64549d18cfc}" ParameterList="True">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	
    MAX_STRING_LENGTH	: UDINT := 255;
	
	
	// Alarm Management
	nMaxNumberAlarms		: UINT := 2000;	// max. number of FB_Alarm or FB_Event instances in the project (combined)
	
	// Logger
	MAX_LOG_STRING_SIZE		: UINT := 1000;	// maximal string size for one log entry (line)
    MAX_BUFFER_COUNT		: UDINT := 1000;
	
	// Following for other HMI solution than TE2000
	nMaxEventEntries		: UINT := 200;	// max. event entries in EventEntryTable
	
	// Listener
	nMaxEventClasses		: UINT := 2;	// Listener - max. event classes
	nNUM_OF_MESSAGES_VISU	: UINT := 15;	// Listener - messages to store and read from HMI
	
	
	// state machine
	NUM_CON			: USINT := 15;
	HISTORY_SIZE	: INT := 30;
	
	// Process
	MAX_POS_INDEX	: INT := 4;
	MAX_TASK_INDEX	: INT := 81;
	MAX_GROUP_INDEX	: INT := 15;
	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>