<?xml version="1.0"?>
<TcModuleClass>
	<Translations>
		<Text TxtId="W_TooManyAlarmsDefined_DisplayText">
			<Text LcId="1031"><![CDATA[Zu viele Alarme instanziiert (Überprüfe Parameter nMaxNumberAlarms)]]></Text>
			<Text LcId="1033"><![CDATA[Too many alarms instanciated ( Check parameter nMaxNumberAlarms)]]></Text>
		</Text>
		<Text TxtId="W_CyclicCallNotDetected_DisplayText">
			<Text LcId="1031"><![CDATA[GVL_Diag.gfbAlarmManagement( bInAck := bAck ); muss irgendwo noch zyklisch aufgerufen werden]]></Text>
			<Text LcId="1033"><![CDATA[You need to call GVL_Diag.gfbAlarmManagement( bInAck := bAck ); somewhere cyclic]]></Text>
		</Text>
		<Text TxtId="E_CylHomePos_DisplayText">
			<Text LcId="1031"><![CDATA[Zylinder konnte die Grundstellung nicht erreichen]]></Text>
			<Text LcId="1033"><![CDATA[Cylinder could not reach the home position]]></Text>
		</Text>
		<Text TxtId="E_CylWorkPos_DisplayText">
			<Text LcId="1031"><![CDATA[Zylinder konnte die Arbeitsstellung nicht erreichen]]></Text>
			<Text LcId="1033"><![CDATA[Cylinder could not reach the work position]]></Text>
		</Text>
		<Text TxtId="E_CylPair_DisplayText">
			<Text LcId="1031"><![CDATA[Zylinder-Sensoren nicht plausibel]]></Text>
			<Text LcId="1033"><![CDATA[Cylinder sensors not plausible]]></Text>
		</Text>
		<Text TxtId="E_CylOutputs_DisplayText">
			<Text LcId="1031"><![CDATA[Zylinder-Ausgänge gleichzeitig angesteuert]]></Text>
			<Text LcId="1033"><![CDATA[Cylinder outputs both set at the same time]]></Text>
		</Text>
		<Text TxtId="E_CylLimitSwitch_DisplayText">
			<Text LcId="1031"><![CDATA[Zylinder Endlagenüberwachung]]></Text>
			<Text LcId="1033"><![CDATA[Cylinder limit switch monitoring]]></Text>
		</Text>
		<Text TxtId="E_MotorStart_DisplayText">
			<Text LcId="1031"><![CDATA[Motor konnte nicht gestartet werden]]></Text>
			<Text LcId="1033"><![CDATA[Motor could not be started]]></Text>
		</Text>
		<Text TxtId="E_ProtSwitch_DisplayText">
			<Text LcId="1031"><![CDATA[Motorschutzschalter ausgelöst]]></Text>
			<Text LcId="1033"><![CDATA[Motor protection switch triggered]]></Text>
		</Text>
		<Text TxtId="W_ArgumentBeforeInit_DisplayText">
			<Text LcId="1031"><![CDATA[Agrumente vor der Initialisierung gesetzt, Texte könnten fehlen]]></Text>
			<Text LcId="1033"><![CDATA[Arguments set before initialization, texts may be missing]]></Text>
		</Text>
